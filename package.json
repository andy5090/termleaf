{
  "name": "termleaf-apps",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "desktop": "pnpm --filter @termleaf/desktop tauri dev",
    "mobile": "pnpm --filter @termleaf/mobile start",
    "test": "node scripts/generate-mobile-glyphs.mjs --check && node --test packages/notebook/test/*.test.ts packages/cloud/test/*.test.ts apps/desktop/tests/*.test.ts && pnpm --filter @termleaf/mobile test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages",
    "build:desktop": "pnpm --filter @termleaf/desktop build",
    "build:mobile": "pnpm --filter @termleaf/mobile exec expo export --platform all"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
    "typescript": "~6.0.3"
  }
}
